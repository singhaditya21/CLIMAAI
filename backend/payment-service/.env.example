# Payment Service Environment Variables

PORT=3000

# Database
DB_HOST=postgres
DB_PORT=5432
DB_USER=climaai
DB_PASSWORD=climaai123
DB_NAME=climaai

# Apple
APPLE_BUNDLE_ID=com.climaai.app
APPLE_SHARED_SECRET=your-app-specific-shared-secret
# Trust anchor for App Store Server Notifications. Download "Apple Root CA - G3"
# from https://www.apple.com/certificateauthority/ and point one of these at it.
# With neither set the Apple webhook rejects every notification.
APPLE_ROOT_CA_PATH=/etc/climaai/AppleRootCA-G3.cer
# APPLE_ROOT_CA_PEM="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"
# Sandbox notifications are signed by Apple too, so a deployment that accepts
# them can be driven by anyone with a free sandbox tester account.
APPLE_ENVIRONMENT=Production

# Google
GOOGLE_PACKAGE_NAME=com.climaai.app
# Play notifications arrive as Cloud Pub/Sub push requests, authenticated by an
# OIDC token rather than a payload signature. Configure the push subscription
# with this service account and audience; with neither set the Google webhook
# rejects every notification.
PUBSUB_AUDIENCE=https://payments.example.com/webhooks/google
PUBSUB_SERVICE_ACCOUNT_EMAIL=play-rtdn-push@your-project.iam.gserviceaccount.com
