# ClimaAI Production Environment Variables
# Copy to .env.production and configure for your deployment

# =============================================================================
# REQUIRED - These MUST be set for production
# =============================================================================

ENVIRONMENT=production
DEBUG=false
APP_NAME=ClimaAI API
APP_VERSION=1.0.0

# Database (Use managed PostgreSQL like Cloud SQL or RDS)
DATABASE_URL=postgresql+asyncpg://${DB_USER}:${DB_PASSWORD}@${DB_HOST}:5432/${DB_NAME}

# Redis (Use managed Redis like MemoryStore or ElastiCache)
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:6379/0
WEATHER_CACHE_TTL=1800
AI_CACHE_TTL=3600

# OpenAI (Required for AI features)
OPENAI_API_KEY=sk-your-production-openai-key
OPENAI_MODEL=gpt-4-turbo-preview

# JWT Authentication (Generate strong secret!)
# Use: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=CHANGE_THIS_TO_SECURE_RANDOM_STRING_MIN_64_CHARS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS - Only allow your production domains
CORS_ORIGINS=["https://climaai.com","https://app.climaai.com","https://api.climaai.com"]

# =============================================================================
# WEATHER DATA SOURCES
# =============================================================================

OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1

# National Weather Service (Free, requires User-Agent)
NWS_USER_AGENT=ClimaAI/1.0 (support@climaai.com)

# RainViewer Radar
RAINVIEWER_API_KEY=

# Google Pollen API
GOOGLE_POLLEN_API_KEY=

# =============================================================================
# MOBILE APPS
# =============================================================================

APPLE_BUNDLE_ID=com.climaai.app
GOOGLE_PACKAGE_NAME=com.climaai.app

# App Store Connect (for receipt validation)
APP_STORE_CONNECT_KEY_ID=
APP_STORE_CONNECT_ISSUER_ID=
APP_STORE_CONNECT_PRIVATE_KEY=

# Google Play (for receipt validation)
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# =============================================================================
# PUSH NOTIFICATIONS
# =============================================================================

# Apple Push Notification Service
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_AUTH_KEY=

# Firebase Cloud Messaging
FCM_SERVER_KEY=
FCM_PROJECT_ID=

# =============================================================================
# MONITORING & LOGGING
# =============================================================================

# Sentry (Error tracking)
SENTRY_DSN=

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# =============================================================================
# RATE LIMITING
# =============================================================================

RATE_LIMIT_PER_MINUTE=60
PREMIUM_RATE_LIMIT_PER_MINUTE=300

# =============================================================================
# FEATURE FLAGS
# =============================================================================

ENABLE_AI_INSIGHTS=true
ENABLE_PREMIUM_FEATURES=true
ENABLE_MOCK_DATA=false
