# Settings recognized by app/config.py for a free, non-commercial deployment.
# Copy to a private env file only after replacing JWT_SECRET. Never commit that
# private file. Accounts and saved locations need DATABASE_URL; public weather
# endpoints can start in degraded mode with it empty. Redis is optional.

ENVIRONMENT=production
DEBUG=false
APP_NAME=ClimaAI API
APP_VERSION=1.0.0

DATABASE_URL=
REDIS_URL=
WEATHER_CACHE_TTL=1800

# Generate a unique secret of at least 32 characters. The placeholder will
# deliberately stop production startup until changed.
JWT_SECRET=REPLACE_WITH_A_UNIQUE_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# Empty means no browser origin may call the API. Add exact HTTPS origins only
# when a browser frontend is ready; native apps do not use browser CORS.
CORS_ORIGINS=[]

# Public Open-Meteo tier is non-commercial; leave the app free and ad-free.
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality-api.open-meteo.com/v1
OPEN_METEO_API_KEY=

# Paid/AI and generated demo data are off for the free release.
OPENAI_API_KEY=
GOOGLE_POLLEN_API_KEY=
ENABLE_AI_INSIGHTS=false
DEMO_MODE=false

# Optional keyed sources. Empty keys cause those providers to be skipped.
OPENWEATHERMAP_API_KEY=
WEATHERBIT_API_KEY=
STORMGLASS_API_KEY=
OPENUV_API_KEY=
METEOBLUE_API_KEY=
NOAA_API_KEY=
PIRATE_WEATHER_API_KEY=
WEATHERAPI_KEY=
