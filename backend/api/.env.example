# ClimaAI Backend Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=ClimaAI API
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://climaai:climaai123@postgres:5432/climaai

# Redis
REDIS_URL=redis://redis:6379/0
WEATHER_CACHE_TTL=1800
AI_CACHE_TTL=3600

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality.open-meteo.com/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# CORS
CORS_ORIGINS=["*"]

# Subscription
APPLE_BUNDLE_ID=com.climaai.app
GOOGLE_PACKAGE_NAME=com.climaai.app
GOOGLE_PRODUCT_ID_MONTHLY=climaai_pro_monthly
GOOGLE_PRODUCT_ID_ANNUAL=climaai_pro_yearly

# Receipt Validation
# Apple: App Store Connect > Your App > App Information > Shared Secret
APPLE_SHARED_SECRET=
# Google: full service-account key JSON, as a single-line string
GOOGLE_SERVICE_ACCOUNT_JSON=

# Optional External Weather APIs (multi-source service)
# Each source is skipped when its key is blank; Open-Meteo, 7Timer, MET Norway
# and NWS need no key and always run.
# https://openweathermap.org/api
OPENWEATHERMAP_API_KEY=
# https://www.weatherbit.io/api
WEATHERBIT_API_KEY=
# https://stormglass.io/
STORMGLASS_API_KEY=
# https://www.openuv.io/
OPENUV_API_KEY=
# https://www.meteoblue.com/en/weather-api
METEOBLUE_API_KEY=
# https://www.ncdc.noaa.gov/cdo-web/webservices/v2
NOAA_API_KEY=

# Feature Flags
ENABLE_AI_INSIGHTS=true
# Mounts /demo endpoints backed by generated mock data. Leave false in production.
DEMO_MODE=false
