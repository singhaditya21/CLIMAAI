# ClimaAI Backend Environment Configuration
# Copy this file to .env and update with your values

# Application
APP_NAME=ClimaAI API
APP_VERSION=1.0.0
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://climaai:climaai123@postgres:5432/climaai

# Redis
REDIS_URL=redis://redis:6379/0
WEATHER_CACHE_TTL=1800
AI_CACHE_TTL=3600

# OpenAI
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview

# Open-Meteo API
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1
OPEN_METEO_AIR_QUALITY_URL=https://air-quality.open-meteo.com/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production-min-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=720

# CORS
CORS_ORIGINS=["*"]

# Subscription
APPLE_BUNDLE_ID=com.climaai.app
GOOGLE_PACKAGE_NAME=com.climaai.app

# Feature Flags
ENABLE_AI_INSIGHTS=true
