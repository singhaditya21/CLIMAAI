<?xml version="1.0" encoding="utf-8"?>
<!--
    DEBUG-ONLY network security configuration.

    Overrides the main source set's copy for debug builds only, so the release
    policy is untouched. This exists because the debug build points at
    http://10.0.2.2:8000 (the emulator's alias for the host machine) while the
    main config sets cleartextTrafficPermitted="false" globally — every request
    to a local backend failed with:

        CLEARTEXT communication to 10.0.2.2 not permitted by network security policy

    The main config's <debug-overrides> block looked like it handled this, but it
    only adds trust anchors; it cannot permit cleartext.
-->
<network-security-config>
    <!-- Local development hosts only. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>

    <!-- Everything else keeps the production posture. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>
</network-security-config>
