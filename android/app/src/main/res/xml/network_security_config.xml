<?xml version="1.0" encoding="utf-8"?>
<!--
    Network Security Configuration for ClimaAI
    Play Store Requirement: Secure communications
-->
<network-security-config>
    <!-- Default: Only allow secure HTTPS connections -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    <!--
        No <debug-overrides> here. That element only takes effect in debuggable
        builds, and those use app/src/debug/res/xml/network_security_config.xml
        instead, which overrides this file. Declaring it in both makes lint fail
        with "Expecting at most 1 <debug-overrides>".

        Its previous comment here claimed to "allow localhost for development",
        which it never did — <debug-overrides> cannot permit cleartext, only add
        trust anchors. That gap is what blocked debug builds from reaching a
        local backend at all.
    -->

    <!-- Production domains with certificate pinning -->
    <domain-config cleartextTrafficPermitted="false">
        <!-- ClimaAI Backend -->
        <domain includeSubdomains="true">api.climaai.com</domain>
        <domain includeSubdomains="true">climaai.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Free Weather APIs (HTTPS only) -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">api.open-meteo.com</domain>
        <domain includeSubdomains="true">air-quality-api.open-meteo.com</domain>
        <domain includeSubdomains="true">nominatim.openstreetmap.org</domain>
        <domain includeSubdomains="true">api.rainviewer.com</domain>
        <domain includeSubdomains="true">tilecache.rainviewer.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
    
    <!-- Map Tiles -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">tile.openweathermap.org</domain>
        <domain includeSubdomains="true">server.arcgisonline.com</domain>
        <domain includeSubdomains="true">basemaps.cartocdn.com</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
