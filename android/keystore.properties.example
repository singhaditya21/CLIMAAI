# Copy to android/keystore.properties and fill in. That file is gitignored.
# storeFile is resolved relative to the android/ directory.
#
# CI reads the same four values from environment variables instead:
#   ANDROID_KEYSTORE_FILE, ANDROID_KEYSTORE_PASSWORD,
#   ANDROID_KEY_ALIAS, ANDROID_KEY_PASSWORD

storeFile=climaai-release.jks
storePassword=
keyAlias=climaai
keyPassword=
